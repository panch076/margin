<UserControl x:Class="MarginApp.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="36,30,36,24">
        <TextBlock DockPanel.Dock="Top" Text="History" Style="{StaticResource PageTitle}" />
        <TextBlock DockPanel.Dock="Top" x:Name="Subtitle" Style="{StaticResource Muted}" Margin="0,0,0,18" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="OpenButton" Content="Review" Style="{DynamicResource AccentButtonStyle}" Padding="18,7" Click="Open_Click" IsEnabled="False" />
            <Button x:Name="DeleteButton" Content="Delete" Padding="18,7" Margin="10,0,0,0" Click="Delete_Click" IsEnabled="False" />
        </StackPanel>
        <ListBox x:Name="List" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
    </DockPanel>
</UserControl>
