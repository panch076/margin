<UserControl x:Class="MarginApp.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,30,36,36" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Home" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,22"
                       Text="Practice with official SAT questions stored on this PC: build your own quizzes or sit a timed, adaptive practice test." />

            <Border x:Name="UpdateCard" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="UpdateTitle" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="UpdateNotes" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="UpdateButton" Style="{DynamicResource AccentButtonStyle}" Padding="16,7" Click="Update_Click" />
                        <Button Content="Release notes" Margin="10,0,0,0" Padding="16,7" Click="ReleaseNotes_Click" />
                    </StackPanel>
                    <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Question bank" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="BankSummary" Style="{StaticResource Muted}" Margin="0,0,0,14" />
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="DownloadButton" Style="{DynamicResource AccentButtonStyle}" Click="Download_Click" Padding="16,7" />
                        <Button x:Name="CancelButton" Content="Stop" Margin="10,0,0,0" Padding="16,7" Visibility="Collapsed" Click="Cancel_Click" />
                    </StackPanel>
                    <ProgressBar x:Name="Progress" Height="6" Margin="0,16,0,6" Visibility="Collapsed" Minimum="0" Maximum="1" />
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Muted}" FontSize="12.5" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="3" Margin="-8,0,-8,16">
                <Border Style="{StaticResource Card}" Margin="8">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="Open question bank" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OpenBank_Click" />
                        <StackPanel>
                            <TextBlock Text="Build a quiz" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="Filter by section, domain, skill and difficulty, pick the questions you want, and take them in the test interface." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="Set up a test" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OpenTest_Click" />
                        <StackPanel>
                            <TextBlock Text="Adaptive practice test" Style="{StaticResource CardTitle}" />
                            <TextBlock Style="{StaticResource Muted}" Text="Two timed modules per section. The second module gets harder or easier depending on how the first one went." />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="8">
                    <DockPanel>
                        <Button x:Name="MissedButton" DockPanel.Dock="Bottom" Content="Retry missed questions" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Missed_Click" />
                        <StackPanel>
                            <TextBlock Text="Fix mistakes" Style="{StaticResource CardTitle}" />
                            <TextBlock x:Name="MissedText" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Your progress" Style="{StaticResource CardTitle}" />
                    <TextBlock x:Name="StatsText" Style="{StaticResource Muted}" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="2,18,0,0">
                <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" />
                <Button x:Name="CheckButton" Content="Check for updates" FontSize="12" Padding="10,3" Margin="12,0,0,0" Click="CheckUpdates_Click" />
                <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="2,10,0,0"
                       Text="Questions are College Board's and are copied from its public question bank for your personal study. Margin is not affiliated with or endorsed by College Board. SAT is a trademark of College Board." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
