<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Margin</AssemblyName>
    <RootNamespace>MarginApp</RootNamespace>
    <Version>1.0.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Margin.ico</ApplicationIcon>
    <Product>Margin</Product>
    <Description>SAT practice: local question bank, quizzes and adaptive tests</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <ProjectReference Include="..\Margin.Core\Margin.Core.csproj" />
    <EmbeddedResource Include="..\..\shared\question.html" LogicalName="question.html" />
    <Resource Include="Assets\Margin.ico" />
    <Resource Include="Assets\Margin-96.png" />
  </ItemGroup>
</Project>
