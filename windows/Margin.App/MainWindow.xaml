<Window x:Class="MarginApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Margin" Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid x:Name="Shell">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0" Margin="12,18,8,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,18">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock Text="M" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="Margin" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="BankFootnote" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="12" Margin="10,0,6,0" />
                <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Tag="home">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE80F;" /><TextBlock Text="Home" Margin="12,0,0,0" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="bank">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8F1;" /><TextBlock Text="Question Bank" Margin="12,0,0,0" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="test">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" /><TextBlock Text="Practice Test" Margin="12,0,0,0" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="history">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" /><TextBlock Text="History" Margin="12,0,0,0" /></StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
            <Border Grid.Column="1" CornerRadius="10,0,0,0" BorderThickness="1,1,0,0" Margin="0,8,0,0"
                    Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ContentControl x:Name="PageHost" />
            </Border>
        </Grid>
        <ContentControl x:Name="Overlay" Visibility="Collapsed" />
    </Grid>
</Window>
