<UserControl x:Class="MarginApp.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="24,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RetryButton" Content="Retry missed questions" Padding="14,7" Margin="0,0,10,0" Click="Retry_Click" />
                    <Button Content="Done" Style="{DynamicResource AccentButtonStyle}" Padding="22,7" Click="Done_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="DateText" Style="{StaticResource Muted}" FontSize="12.5" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="340" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" MaxHeight="330">
                    <StackPanel Margin="20,18,14,8">
                        <UniformGrid x:Name="Tiles" Rows="1" Margin="-5,0,-5,10" />
                        <TextBlock x:Name="EstimateNote" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12" />
                        <StackPanel x:Name="ModuleLines" />
                        <TextBlock Text="By domain" FontWeight="SemiBold" Margin="0,12,0,6" />
                        <StackPanel x:Name="DomainLines" />
                    </StackPanel>
                </ScrollViewer>
                <DockPanel DockPanel.Dock="Top" Margin="20,8,14,6">
                    <CheckBox x:Name="OnlyMissed" DockPanel.Dock="Right" Content="Missed only" Checked="OnlyMissed_Changed" Unchecked="OnlyMissed_Changed" />
                    <TextBlock Text="Questions" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox x:Name="Questions" Margin="12,0,6,12" SelectionChanged="Questions_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ContentControl x:Name="WebHost" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
